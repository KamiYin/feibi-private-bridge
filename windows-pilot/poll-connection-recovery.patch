+++ b/pkg/controlplane/internal/poll_trace.go
@@ -0,0 +1,63 @@
+package internal
+
+import (
+	"crypto/tls"
+	"github.com/openai/tunnel-client/pkg/controlplane"
+	"net/http/httptrace"
+	"sync"
+	"time"
+)
+
+// Finish freezes this attempt so late callbacks cannot overwrite the next poll.
+func newPollTrace(health *controlplane.PollHealth) (*httptrace.ClientTrace, func()) {
+	var mu sync.Mutex
+	start := time.Now()
+	phase, protocol := "get_connection", ""
+	reused, finished := false, false
+	update := func(next string, connection *httptrace.GotConnInfo) {
+		mu.Lock()
+		defer mu.Unlock()
+		if finished {
+			return
+		}
+		phase = next
+		if connection != nil {
+			reused = connection.Reused
+			protocol = "http/1.1"
+			if conn, ok := connection.Conn.(interface{ ConnectionState() tls.ConnectionState }); ok && conn.ConnectionState().NegotiatedProtocol == "h2" {
+				protocol = "h2"
+			}
+		}
+		health.TransportObservation(phase, reused, protocol, time.Since(start))
+	}
+	update(phase, nil)
+	trace := &httptrace.ClientTrace{
+		GetConn:      func(string) { update("get_connection", nil) },
+		DNSStart:     func(httptrace.DNSStartInfo) { update("dns", nil) },
+		ConnectStart: func(string, string) { update("connect", nil) },
+		ConnectDone: func(_, _ string, err error) {
+			if err == nil {
+				update("connected", nil)
+			}
+		},
+		TLSHandshakeStart: func() { update("tls_handshake", nil) },
+		TLSHandshakeDone: func(_ tls.ConnectionState, err error) {
+			if err == nil {
+				update("tls_ready", nil)
+			}
+		},
+		GotConn: func(info httptrace.GotConnInfo) { update("write_request", &info) },
+		WroteRequest: func(info httptrace.WroteRequestInfo) {
+			if info.Err == nil {
+				update("wait_response", nil)
+			}
+		},
+		GotFirstResponseByte: func() { update("read_response", nil) },
+	}
+	return trace, func() {
+		mu.Lock()
+		defer mu.Unlock()
+		finished = true
+		health.TransportObservation(phase, reused, protocol, time.Since(start))
+	}
+}
