diff --git a/pkg/controlplane/internal/poll_connection_pool.go b/pkg/controlplane/internal/poll_connection_pool.go
new file mode 100644
index 0000000..16c8128
--- /dev/null
+++ b/pkg/controlplane/internal/poll_connection_pool.go
@@ -0,0 +1,59 @@
+package internal
+
+import (
+	"context"
+	"net/http"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+// pollConnectionPool sits below auth/metrics wrappers. Retiring it never
+// replays an in-flight request.
+type pollConnectionPool struct {
+	current   atomic.Pointer[http.Transport]
+	mu        sync.Mutex
+	deadlines int
+}
+
+func newPollConnectionPool(transport *http.Transport) *pollConnectionPool {
+	p := &pollConnectionPool{}
+	p.current.Store(transport)
+	return p
+}
+func (p *pollConnectionPool) RoundTrip(req *http.Request) (*http.Response, error) {
+	return p.current.Load().RoundTrip(req)
+}
+func (p *pollConnectionPool) CloseIdleConnections() { p.current.Load().CloseIdleConnections() }
+func (p *pollConnectionPool) observePoll(deadline bool) bool {
+	p.mu.Lock()
+	defer p.mu.Unlock()
+	if !deadline {
+		p.deadlines = 0
+		return false
+	}
+	p.deadlines++
+	if p.deadlines < 1 {
+		return false
+	}
+	p.deadlines = 0
+	old := p.current.Load()
+	// Clone retains proxy, CA, mTLS, dial and protocol configuration, but has a
+	// fresh pool. Active response uploads finish on the retired transport.
+	p.current.Store(old.Clone())
+	// Reach the actual transport, independent of outer wrapper forwarding.
+	old.CloseIdleConnections()
+	return true
+}
+
+// pollAttemptContext distinguishes the poller's own deadline from cancellation
+// of the runtime that owns it. The fetcher still receives a bounded context.
+type pollAttemptContext struct {
+	context.Context
+	parent context.Context
+}
+
+func newPollAttemptContext(parent context.Context, timeout time.Duration) (context.Context, context.CancelFunc) {
+	bounded, cancel := context.WithTimeout(parent, timeout)
+	return pollAttemptContext{Context: bounded, parent: parent}, cancel
+}
