@@ -0,0 +1,273 @@
+package internal
+
+import (
+	"context"
+	"crypto/x509"
+	"errors"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"net/http/httptrace"
+	"net/url"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/openai/tunnel-client/pkg/config"
+	"github.com/openai/tunnel-client/pkg/controlplane"
+	"github.com/openai/tunnel-client/pkg/healthstate"
+	"github.com/openai/tunnel-client/pkg/tlsconfig"
+	"github.com/openai/tunnel-client/pkg/tunnelctx"
+	"github.com/openai/tunnel-client/pkg/types"
+	"github.com/stretchr/testify/require"
+)
+
+func recoveryClient(t *testing.T, server *httptest.Server) (*TunnelServiceClient, *controlplane.PollHealth) {
+	t.Helper()
+	roots := x509.NewCertPool()
+	roots.AddCert(server.Certificate())
+	cfg := &config.ControlPlaneConfig{BaseURL: mustParseURL(t, server.URL), TunnelID: "test-tunnel", APIKey: "synthetic-test-key", PollTimeout: 2 * time.Second, PollDeadlineGuardrail: time.Second, SuppressRawHTTPLogging: true}
+	c, err := NewTunnelServiceClient(t.Context(), cfg, &tlsconfig.Bundle{RootCAs: roots}, newDiscardLogger(), &config.LoggingConfig{}, testMeterProvider)
+	require.NoError(t, err)
+	require.NotNil(t, c.pollPool)
+	health := controlplane.NewPollHealth(cfg)
+	c.ObserveHealth(health, nil)
+	t.Cleanup(c.pollPool.CloseIdleConnections)
+	return c, health
+}
+
+// Real HTTP/2 streams reuse the first TCP connection across deadlines. Recovery
+// must replace the underlying pool through all production middleware.
+func TestPollRecoveryReplacesHTTP2PoolWithoutReplayingResponse(t *testing.T) {
+	var stalled atomic.Bool
+	var postCount atomic.Int32
+	seen := make(chan string, 10)
+	postStarted, releasePost := make(chan struct{}), make(chan struct{})
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.ProtoMajor != 2 {
+			t.Errorf("expected HTTP/2, got %s", r.Proto)
+		}
+		if r.Header.Get("Authorization") != "Bearer synthetic-test-key" {
+			t.Error("authentication not preserved")
+		}
+		if strings.HasSuffix(r.URL.Path, "/response") {
+			postCount.Add(1)
+			close(postStarted)
+			select {
+			case <-releasePost:
+				w.WriteHeader(200)
+			case <-r.Context().Done():
+			}
+			return
+		}
+		seen <- r.RemoteAddr
+		if stalled.Load() {
+			<-r.Context().Done()
+			return
+		}
+		w.WriteHeader(204)
+	}))
+	server.EnableHTTP2 = true
+	server.StartTLS()
+	defer server.Close()
+	defer func() {
+		select {
+		case <-releasePost:
+		default:
+			close(releasePost)
+		}
+	}()
+	c, health := recoveryClient(t, server)
+	_, _, err := c.Poll(t.Context(), 1)
+	require.NoError(t, err)
+	first := <-seen
+	original := c.pollPool.current.Load()
+	postDone := make(chan error, 1)
+	go func() {
+		ctx := tunnelctx.ContextWithChannel(tunnelctx.ContextWithShardToken(t.Context(), "synthetic-shard"), types.DefaultChannel)
+		_, err := c.PostResponse(ctx, "synthetic-request", types.NewNotificationAck(types.DefaultChannel, http.StatusOK, http.Header{}))
+		postDone <- err
+	}()
+	<-postStarted
+	stalled.Store(true)
+	c.pollTimeout, c.pollGuardrail = 300*time.Millisecond, 200*time.Millisecond
+	for i := 0; i < 1; i++ {
+		_, _, err = c.Poll(t.Context(), 1)
+		require.ErrorIs(t, err, context.DeadlineExceeded)
+		require.Equal(t, first, <-seen, "pre-recovery polls should reuse the established connection")
+	}
+	d := health.Snapshot(time.Now()).Details.(healthstate.PollingDetails)
+	require.EqualValues(t, 1, d.ConnectionPoolResets)
+	require.Equal(t, "wait_response", d.TransportPhase)
+	require.Equal(t, "h2", d.TransportProtocol)
+	require.True(t, d.TransportReused)
+	require.GreaterOrEqual(t, d.TransportElapsedMS, int64(450))
+	require.NotSame(t, original, c.pollPool.current.Load())
+	require.False(t, c.pollPool.current.Load().TLSClientConfig.InsecureSkipVerify)
+	require.Equal(t, original.TLSClientConfig.RootCAs, c.pollPool.current.Load().TLSClientConfig.RootCAs)
+	stalled.Store(false)
+	_, _, err = c.Poll(t.Context(), 1)
+	require.NoError(t, err)
+	require.NotEqual(t, first, <-seen, "next poll must use a new TCP connection")
+	d = health.Snapshot(time.Now()).Details.(healthstate.PollingDetails)
+	require.False(t, d.TransportReused)
+	require.Equal(t, "h2", d.TransportProtocol)
+	close(releasePost)
+	require.NoError(t, <-postDone, "active response upload must finish on its original connection")
+	require.EqualValues(t, 1, postCount.Load(), "pool recovery must not replay responses")
+	original.CloseIdleConnections()
+}
+
+func TestPollRecoveryOnlyCountsOwnDeadlines(t *testing.T) {
+	var mode atomic.Int32
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		switch mode.Load() {
+		case 1:
+			<-r.Context().Done()
+		case 2:
+			w.WriteHeader(503)
+		default:
+			time.Sleep(10 * time.Millisecond)
+			w.WriteHeader(204)
+		}
+	}))
+	server.EnableHTTP2 = true
+	server.StartTLS()
+	defer server.Close()
+	c, health := recoveryClient(t, server)
+	_, _, err := c.Poll(t.Context(), 1)
+	require.NoError(t, err)
+	c.pollTimeout, c.pollGuardrail = 50*time.Millisecond, 50*time.Millisecond
+	timeout := func() {
+		t.Helper()
+		mode.Store(1)
+		_, _, err := c.Poll(t.Context(), 1)
+		require.ErrorIs(t, err, context.DeadlineExceeded)
+	}
+	resets := func() uint64 {
+		return health.Snapshot(time.Now()).Details.(healthstate.PollingDetails).ConnectionPoolResets
+	}
+	mode.Store(0)
+	_, _, err = c.Poll(t.Context(), 1)
+	require.NoError(t, err)
+	require.Zero(t, resets(), "successful empty long poll must not recycle the pool")
+	mode.Store(2)
+	_, _, err = c.Poll(t.Context(), 1)
+	require.Error(t, err)
+	require.False(t, errors.Is(err, context.DeadlineExceeded))
+	require.Zero(t, resets(), "HTTP errors are not local deadlines")
+	mode.Store(1)
+	ctx, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
+	_, _, err = c.Poll(ctx, 1)
+	cancel()
+	require.ErrorIs(t, err, context.DeadlineExceeded)
+	require.Zero(t, resets(), "parent deadline must not recycle the pool")
+	ctx, cancel = context.WithCancel(t.Context())
+	started := make(chan struct{})
+	c.client.Transport = cancelAfterStartTransport{base: c.client.Transport, started: started}
+	go func() { <-started; cancel() }()
+	_, _, err = c.Poll(ctx, 1)
+	require.ErrorIs(t, err, context.Canceled)
+	require.Zero(t, resets(), "parent cancellation must not recycle the pool")
+	require.Zero(t, resets())
+	timeout()
+	require.EqualValues(t, 1, resets())
+}
+
+func TestPollPoolClosesActualIdleConnectionAndPreservesProxy(t *testing.T) {
+	closed := make(chan struct{}, 4)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) { w.WriteHeader(204) }))
+	server.Config.ConnState = func(_ net.Conn, state http.ConnState) {
+		if state == http.StateClosed {
+			closed <- struct{}{}
+		}
+	}
+	server.Start()
+	defer server.Close()
+	var proxyCalls atomic.Int32
+	base := http.DefaultTransport.(*http.Transport).Clone()
+	base.Proxy = func(r *http.Request) (*url.URL, error) { proxyCalls.Add(1); return nil, nil }
+	pool := newPollConnectionPool(base)
+	t.Cleanup(pool.CloseIdleConnections)
+	client := &http.Client{Transport: newResponseReceiptRoundTripper(pool)}
+	res, err := client.Get(server.URL)
+	require.NoError(t, err)
+	require.NoError(t, res.Body.Close())
+	require.True(t, pool.observePoll(true))
+	select {
+	case <-closed:
+	case <-time.After(2 * time.Second):
+		t.Fatal("actual idle network connection was not closed")
+	}
+	res, err = client.Get(server.URL)
+	require.NoError(t, err)
+	require.NoError(t, res.Body.Close())
+	require.EqualValues(t, 2, proxyCalls.Load(), "proxy callback retained after clone")
+}
+
+func TestPollTraceFreezesCompletedAttempt(t *testing.T) {
+	health := controlplane.NewPollHealth(nil)
+	trace, finish := newPollTrace(health)
+	trace.ConnectStart("tcp", "synthetic-address-not-for-health")
+	trace.WroteRequest(httptrace.WroteRequestInfo{})
+	finish()
+	trace.TLSHandshakeStart()
+	d := health.Snapshot(time.Now()).Details.(healthstate.PollingDetails)
+	require.Equal(t, "wait_response", d.TransportPhase)
+}
+
+func TestPollRecoveryCountsProductionPollerDeadline(t *testing.T) {
+	var stalled atomic.Bool
+	seen := make(chan string, 12)
+	server := httptest.NewUnstartedServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		seen <- r.RemoteAddr
+		if stalled.Load() {
+			<-r.Context().Done()
+			return
+		}
+		w.WriteHeader(204)
+	}))
+	server.EnableHTTP2 = true
+	server.StartTLS()
+	defer server.Close()
+	c, health := recoveryClient(t, server)
+	_, _, err := c.Poll(t.Context(), 1)
+	require.NoError(t, err)
+	first := <-seen
+	stalled.Store(true)
+	resets := func() uint64 {
+		return health.Snapshot(time.Now()).Details.(healthstate.PollingDetails).ConnectionPoolResets
+	}
+	attempt := func(parent context.Context) {
+		ctx, cancel := newPollAttemptContext(parent, 100*time.Millisecond)
+		defer cancel()
+		_, _, err := c.Poll(ctx, 1)
+		require.ErrorIs(t, err, context.DeadlineExceeded)
+		require.Equal(t, first, <-seen)
+	}
+	parent, cancel := context.WithTimeout(t.Context(), 20*time.Millisecond)
+	attempt(parent)
+	cancel()
+	require.Zero(t, resets(), "real parent deadline must not recycle the pool")
+	attempt(t.Context())
+	require.EqualValues(t, 1, resets())
+	stalled.Store(false)
+	_, _, err = c.Poll(t.Context(), 1)
+	require.NoError(t, err)
+	require.NotEqual(t, first, <-seen, "production poller deadline must retire the real HTTP/2 pool")
+}
+
+type cancelAfterStartTransport struct {
+	base    http.RoundTripper
+	started chan struct{}
+}
+
+func (t cancelAfterStartTransport) RoundTrip(r *http.Request) (*http.Response, error) {
+	select {
+	case <-t.started:
+	default:
+		close(t.started)
+	}
+	return t.base.RoundTrip(r)
+}
