+func TestOriginGuardEveryClientRejectsRedirectsWithoutFollowing(t *testing.T) {
+	t.Parallel()
+	for _, useProvider := range []bool{false, true} {
+		for _, status := range []int{301, 302, 303, 307, 308} {
+			cfg := &runtimeconfig.ControlPlaneConfig{BaseURL: &url.URL{Scheme: "https", Host: "approved.invalid"}, TunnelID: "tunnel_synthetic", APIKey: "synthetic-token"}
+			if useProvider {
+				cfg.TokenProvider = staticBearerToken("synthetic-token")
+			}
+			client, err := NewTunnelServiceClient(context.Background(), cfg, nil, newDiscardLogger(), &runtimeconfig.LoggingConfig{}, metricnoop.NewMeterProvider())
+			if err != nil {
+				t.Fatal(err)
+			}
+			for _, c := range []*http.Client{client.client, client.secretClient} {
+				auth, ok := c.Transport.(*controlPlaneRoundTripper)
+				if !ok {
+					t.Fatal("production transport missing origin guard")
+				}
+				calls := 0
+				auth.base = roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+					calls++
+					return &http.Response{StatusCode: status, Header: http.Header{"Location": []string{"https://other.invalid/never-contact"}}, Body: io.NopCloser(strings.NewReader("")), Request: req}, nil
+				})
+				req, _ := http.NewRequest("GET", "https://approved.invalid/v1/test", nil)
+				response, err := c.Do(req)
+				if err != nil {
+					t.Fatal(err)
+				}
+				response.Body.Close()
+				if response.StatusCode != status || calls != 1 {
+					t.Fatal("redirect followed")
+				}
+				if c.CheckRedirect == nil || c.CheckRedirect(req, nil) != http.ErrUseLastResponse {
+					t.Fatal("redirect policy absent")
+				}
+			}
+		}
+	}
+}
