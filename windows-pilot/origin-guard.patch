+func TestOriginGuardMalformedRequestNeverReadsCredentials(t *testing.T) {
+	t.Parallel()
+	called := 0
+	rt := newControlPlaneRoundTripper(roundTripperFunc(func(*http.Request) (*http.Response, error) { called++; return nil, nil }), &url.URL{Scheme: "https", Host: "approved.invalid"}, func(context.Context) (string, error) { called++; return "synthetic", nil }, "ua", "", nil, nil, newDiscardLogger())
+	requests := []*http.Request{nil, {}, {URL: &url.URL{Scheme: "https", Host: "approved.invalid:bad"}}, {URL: &url.URL{Scheme: "https", Host: "approved.invalid/path"}}, {URL: &url.URL{Scheme: "https", Host: "approved.invalid", Opaque: "//other.invalid"}}, {URL: &url.URL{Scheme: "https", Host: "approved.invalid", User: url.UserPassword("user", "synthetic")}}}
+	for _, req := range requests {
+		if _, err := rt.RoundTrip(req); err == nil {
+			t.Fatal("malformed request accepted")
+		}
+	}
+	if called != 0 {
+		t.Fatal("malformed request reached token or transport")
+	}
+}
