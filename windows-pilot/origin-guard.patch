+// controlPlaneOrigin is immutable after construction. HTTP remains supported
+// only when explicitly configured (e.g. upstream local fixtures); an HTTPS
+// origin can never authorize an HTTP downgrade.
+type controlPlaneOrigin struct {
+	scheme string
+	host   string
+	port   string
+}
+
+func canonicalControlPlaneOrigin(u *url.URL) (controlPlaneOrigin, bool) {
+	if u == nil || u.User != nil || u.Opaque != "" || u.Host == "" {
+		return controlPlaneOrigin{}, false
+	}
+	scheme := strings.ToLower(u.Scheme)
+	if scheme != "https" && scheme != "http" {
+		return controlPlaneOrigin{}, false
+	}
+	// Parse the authority independently to reject malformed ports, embedded
+	// userinfo and authority strings containing path/query/fragment components.
+	authority, err := url.Parse(scheme + "://" + u.Host)
+	if err != nil || authority.User != nil || authority.Host != u.Host || authority.Hostname() == "" || authority.Path != "" || authority.RawQuery != "" || authority.Fragment != "" {
+		return controlPlaneOrigin{}, false
+	}
+	port := authority.Port()
+	if port == "" {
+		port = "443"
+		if scheme == "http" {
+			port = "80"
+		}
+	}
+	number, err := strconv.Atoi(port)
+	if err != nil || number < 1 || number > 65535 {
+		return controlPlaneOrigin{}, false
+	}
+	return controlPlaneOrigin{scheme, strings.ToLower(authority.Hostname()), strconv.Itoa(number)}, true
+}
+
+func (c *controlPlaneRoundTripper) originApproved(req *http.Request) bool {
+	if req == nil || c.approvedOrigin.scheme == "" {
+		return false
+	}
+	origin, ok := canonicalControlPlaneOrigin(req.URL)
+	if !ok || origin != c.approvedOrigin {
+		return false
+	}
+	if req.Host != "" {
+		hostOrigin, valid := canonicalControlPlaneOrigin(&url.URL{Scheme: req.URL.Scheme, Host: req.Host})
+		if !valid || hostOrigin != c.approvedOrigin {
+			return false
+		}
+	}
+	return true
+}
