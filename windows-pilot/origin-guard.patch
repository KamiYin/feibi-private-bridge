+func TestOriginGuardEnvReferenceResolvesBeforeActualAPIRequests(t *testing.T) {
+	t.Parallel()
+	const expected = "synthetic-runtime-value-not-a-real-key"
+	env := map[string]string{"BOUNDED_TUNNEL_RUNTIME_SECRET": expected}
+	cfg, err := runtimeconfig.Load([]string{
+		"--profile-dir", t.TempDir(),
+		"--control-plane.api-key", "env:BOUNDED_TUNNEL_RUNTIME_SECRET",
+		"--control-plane.tunnel-id", "tunnel_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
+		"--control-plane.base-url", "https://api.openai.com",
+		"--control-plane.poll-channel", "main",
+		"--mcp.server-url", "url=http://127.0.0.1:8767/mcp,channel=main",
+	}, runtimeconfig.FlavorRuntime, func(k string) (string, bool) { v, ok := env[k]; return v, ok })
+	if err != nil {
+		t.Fatal("synthetic official config failed")
+	}
+	if cfg.ControlPlane.APIKey != expected || cfg.ControlPlane.TokenProvider != nil {
+		t.Fatal("env reference not resolved as static key")
+	}
+	token, err := cfg.ControlPlane.BearerToken(context.Background())
+	if err != nil || token != expected {
+		t.Fatal("resolved token mismatch")
+	}
+	client, err := NewTunnelServiceClient(context.Background(), &cfg.ControlPlane, nil, newDiscardLogger(), &runtimeconfig.LoggingConfig{}, metricnoop.NewMeterProvider())
+	if err != nil {
+		t.Fatal("synthetic client construction failed")
+	}
+	calls := 0
+	fake := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		calls++
+		if req.Header.Get("Authorization") != "Bearer "+expected {
+			t.Fatal("synthetic Authorization mismatch")
+		}
+		if req.URL.Scheme != "https" || req.URL.Host != "api.openai.com" {
+			t.Fatal("unexpected authority")
+		}
+		return &http.Response{StatusCode: 401, Header: http.Header{}, Body: io.NopCloser(strings.NewReader(`{"error":{"code":"synthetic_unauthorized"}}`)), Request: req}, nil
+	})
+	client.client.Transport.(*controlPlaneRoundTripper).base = fake
+	if _, err = client.FetchTunnelMetadata(context.Background()); err == nil {
+		t.Fatal("synthetic metadata401 not rejected")
+	}
+	if _, _, err = client.Poll(context.Background(), 1); err == nil {
+		t.Fatal("synthetic poll401 not rejected")
+	}
+	if calls != 2 {
+		t.Fatal("unexpected synthetic request count")
+	}
+}
