+func TestOriginGuardRejectsBeforeCredentialsOrTransport(t *testing.T) {
+	t.Parallel()
+	for _, target := range []string{"https://other.invalid/v1", "http://approved.invalid/v1", "https://approved.invalid:444/v1", "https://user:pass@approved.invalid/v1", "https://approved.invalid.evil/v1"} {
+		t.Run(target, func(t *testing.T) {
+			t.Parallel()
+			tokens, headers, calls := 0, 0, 0
+			rt := newControlPlaneRoundTripper(roundTripperFunc(func(*http.Request) (*http.Response, error) { calls++; return nil, nil }), &url.URL{Scheme: "https", Host: "approved.invalid"}, func(context.Context) (string, error) { tokens++; return "synthetic-token", nil }, "ua", "", func() (string, error) { headers++; return "synthetic-info", nil }, nil, newDiscardLogger())
+			req, err := http.NewRequest(http.MethodGet, target, nil)
+			if err != nil {
+				t.Fatal(err)
+			}
+			_, err = rt.RoundTrip(req)
+			if err == nil || err.Error() != "controlplane client: request origin not approved" || tokens != 0 || headers != 0 || calls != 0 || req.Header.Get("Authorization") != "" {
+				t.Fatal("unapproved origin reached credential/header/transport work")
+			}
+		})
+	}
+}
+
+func TestOriginGuardCapturesOriginAndChecksHostOverride(t *testing.T) {
+	t.Parallel()
+	original := &url.URL{Scheme: "https", Host: "approved.invalid"}
+	calls := 0
+	rt := newControlPlaneRoundTripper(roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+		calls++
+		if req.Header.Get("Authorization") != "Bearer synthetic-token" {
+			t.Fatal("missing synthetic auth")
+		}
+		return &http.Response{StatusCode: 204, Body: io.NopCloser(strings.NewReader("")), Request: req}, nil
+	}), original, staticBearerToken("synthetic-token"), "ua", "", nil, nil, newDiscardLogger())
+	original.Host = "mutated.invalid"
+	for _, host := range []string{"other.invalid", "approved.invalid:444", "user@approved.invalid"} {
+		req, _ := http.NewRequest("GET", "https://approved.invalid/test", nil)
+		req.Host = host
+		if _, err := rt.RoundTrip(req); err == nil {
+			t.Fatal("invalid Host accepted")
+		}
+	}
+	req, _ := http.NewRequest("GET", "https://APPROVED.invalid:443/test", nil)
+	if _, err := rt.RoundTrip(req); err != nil {
+		t.Fatal(err)
+	}
+	if calls != 1 {
+		t.Fatal("wrong transport call count")
+	}
+	req, _ = http.NewRequest("GET", "https://mutated.invalid/test", nil)
+	if _, err := rt.RoundTrip(req); err == nil {
+		t.Fatal("mutable config expanded origin")
+	}
+}
