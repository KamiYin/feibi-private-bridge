+func TestOriginGuardActualAPIMethodsNeverFollowSameOrCrossOriginRedirects(t *testing.T) {
+	t.Parallel()
+	for _, location := range []string{"https://approved.invalid/elsewhere", "https://other.invalid/never-contact"} {
+		for _, method := range []string{"metadata", "poll", "response", "managed-secret"} {
+			cfg := &runtimeconfig.ControlPlaneConfig{BaseURL: &url.URL{Scheme: "https", Host: "approved.invalid"}, TunnelID: "tunnel_synthetic", APIKey: "synthetic-token"}
+			client, err := NewTunnelServiceClient(context.Background(), cfg, nil, newDiscardLogger(), &runtimeconfig.LoggingConfig{}, metricnoop.NewMeterProvider())
+			if err != nil {
+				t.Fatal(err)
+			}
+			calls := 0
+			fake := roundTripperFunc(func(req *http.Request) (*http.Response, error) {
+				calls++
+				return &http.Response{StatusCode: 307, Header: http.Header{"Location": []string{location}}, Body: io.NopCloser(strings.NewReader("")), Request: req}, nil
+			})
+			client.client.Transport.(*controlPlaneRoundTripper).base = fake
+			client.secretClient.Transport.(*controlPlaneRoundTripper).base = fake
+			client.responseRetryAttempts = 1
+			client.managedCloudflareRetryAttempts = 1
+			ctx := tunnelctx.ContextWithChannel(tunnelctx.ContextWithShardToken(context.Background(), "synthetic-shard"), types.DefaultChannel)
+			switch method {
+			case "metadata":
+				_, err = client.FetchTunnelMetadata(ctx)
+			case "poll":
+				_, _, err = client.Poll(ctx, 1)
+			case "response":
+				_, err = client.PostResponse(ctx, "synthetic-request", types.NewNotificationAck(types.DefaultChannel, http.StatusOK, http.Header{}))
+			case "managed-secret":
+				_, err = client.FetchManagedCloudflareTunnel(ctx)
+			}
+			if err == nil || calls != 1 {
+				t.Fatalf("method %s did not reject one redirect", method)
+			}
+		}
+	}
+}
