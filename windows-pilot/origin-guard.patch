+func TestOriginGuardInvalidOriginAndMalformedRequestsFailClosed(t *testing.T) {
+	t.Parallel()
+	for _, origin := range []*url.URL{nil, {Scheme: "ftp", Host: "approved.invalid"}, {Scheme: "https", Host: "approved.invalid:bad"}, {Scheme: "https", Host: "approved.invalid/path"}, {Scheme: "https", Host: "user@approved.invalid"}} {
+		rt := newControlPlaneRoundTripper(roundTripperFunc(func(*http.Request) (*http.Response, error) { t.Fatal("unexpected transport"); return nil, nil }), origin, func(context.Context) (string, error) { t.Fatal("unexpected credential read"); return "", nil }, "ua", "", nil, nil, newDiscardLogger())
+		req, _ := http.NewRequest("GET", "https://approved.invalid/test", nil)
+		if _, err := rt.RoundTrip(req); err == nil {
+			t.Fatal("invalid origin accepted")
+		}
+		if _, err := rt.RoundTrip(nil); err == nil {
+			t.Fatal("nil request accepted")
+		}
+	}
+}
